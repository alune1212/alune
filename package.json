{
  "name": "alune",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A long-lived personal digital home for Alune.",
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=26.3.0 <27",
    "pnpm": ">=11.20.0 <12"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "docs:check": "node scripts/check-docs.mjs",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm build && pnpm e2e:ci",
    "e2e:preview": "playwright test",
    "e2e:content": "playwright test --config playwright.content.config.ts",
    "e2e:ci": "pnpm e2e:preview && pnpm e2e:content",
    "e2e:list": "playwright test --list && playwright test --config playwright.content.config.ts --list",
    "check": "pnpm docs:check && pnpm lint && pnpm format:check && pnpm typecheck && pnpm test && pnpm build",
    "check:release": "node scripts/check-release.mjs && pnpm check"
  },
  "dependencies": {
    "@astrojs/mdx": "8.0.3",
    "@astrojs/rss": "4.0.19",
    "@astrojs/sitemap": "3.7.4",
    "astro": "7.3.8",
    "markdown-it": "15.0.2",
    "sanitize-html": "2.18.0"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/sanitize-html": "2.16.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.12.0",
    "eslint-plugin-astro": "3.2.1",
    "prettier": "3.9.10",
    "prettier-plugin-astro": "1.1.1",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  }
}
