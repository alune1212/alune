    "test": "vitest run"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.100.14",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@tanstack/react-query": "^5.100.14",
    "orval": "^8.12.3",
    "react": "^19.2.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  }
}
