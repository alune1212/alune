{
  "name": "@alune/api-client",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./generated": "./src/generated/api.ts"
  },
  "scripts": {
    "openapi:export": "pnpm --filter @alune/api openapi:export",
    "generate": "pnpm run openapi:export && orval --config orval.config.ts",
