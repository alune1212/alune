---
import EntryList from "../../components/EntryList.astro";
import ListingLayout from "../../layouts/ListingLayout.astro";
import { getJournalEntries, getStudioEntries } from "../../lib/collections";
import { deriveUsedTopics, topicLabel } from "../../lib/topics";
import { journalViewModel, studioViewModel } from "../../lib/view-models";

export async function getStaticPaths() {
  const [studio, journal] = await Promise.all([
    getStudioEntries({ production: import.meta.env.PROD }),
    getJournalEntries({ production: import.meta.env.PROD }),
  ]);
  const topics = deriveUsedTopics(
    [...studio, ...journal].map((entry) => entry.data),
    {
      production: import.meta.env.PROD,
    },
  );
  return topics.map((topic) => ({ params: { topic } }));
}

const topic = Astro.params.topic ?? "";
const [studio, journal] = await Promise.all([
  getStudioEntries({ production: import.meta.env.PROD }),
  getJournalEntries({ production: import.meta.env.PROD }),
]);
const studioItems = studio
  .filter((entry) => entry.data.topics.includes(topic))
  .map(studioViewModel);
const journalItems = journal
  .filter((entry) => entry.data.topics.includes(topic))
  .map(journalViewModel);
const label = topicLabel(topic);
---

<ListingLayout
  title={label}
  eyebrow="主题 / 共同线索"
  description={`${label} 连接的作品与文章。`}
  bodyClass="topic-page"
>
  <section class="topic-group" aria-labelledby="topic-studio">
    <h2 id="topic-studio">作品</h2>
    <EntryList
      entries={studioItems}
      label={`${label} 主题下的作品`}
      emptyTitle="这个主题下还没有作品。"
    />
  </section>
  <section class="topic-group" aria-labelledby="topic-journal">
    <h2 id="topic-journal">文章</h2>
    <EntryList
      entries={journalItems}
      label={`${label} 主题下的文章`}
      emptyTitle="这个主题下还没有文章。"
    />
  </section>
</ListingLayout>
