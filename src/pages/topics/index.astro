---
import EmptyState from "../../components/EmptyState.astro";
import TopicList from "../../components/TopicList.astro";
import type { TopicItem } from "../../components/types";
import ListingLayout from "../../layouts/ListingLayout.astro";
import { getJournalEntries, getStudioEntries } from "../../lib/collections";
import { countTopics, topicLabel } from "../../lib/content";
import { topicPath } from "../../lib/routes";

const production = import.meta.env.PROD;
const [studio, journal] = await Promise.all([
  getStudioEntries({ production }),
  getJournalEntries({ production }),
]);
const counts = countTopics([...studio, ...journal].map((entry) => entry.data));
const topics: TopicItem[] = Object.entries(counts).map(([slug, count]) => ({
  slug,
  label: topicLabel(slug),
  count,
  href: topicPath(slug),
}));
---

<ListingLayout
  title="主题"
  eyebrow="索引 / 共同线索"
  description="连接作品与文章的共同主题。"
  bodyClass="topics-page"
>
  {
    topics.length > 0 ? (
      <TopicList
        topics={topics}
        baseHref="/topics/"
        label="全部主题"
        class="topics-index"
      />
    ) : (
      <EmptyState
        title="还没有主题。"
        message="当发布的作品和文章使用主题后，这里会自动生成索引。"
      />
    )
  }
</ListingLayout>
