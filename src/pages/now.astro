---
import { render } from "astro:content";

import ArrowLink from "../components/ArrowLink.astro";
import { site } from "../config/site";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getSingletonPage } from "../lib/collections";
import { formatDate, toIsoDate } from "../lib/dates";

const page = await getSingletonPage("now", {
  production: import.meta.env.PROD,
});
const rendered = page ? await render(page) : undefined;
const PageContent = rendered?.Content;
const title = page?.data.title ?? "近况";
const description = page?.data.summary ?? site.now.summary;
const updatedAt =
  page?.data.updatedAt ?? new Date(`${site.now.updatedAt}T00:00:00Z`);
---

<BaseLayout title={title} description={description} bodyClass="now-page">
  <article class="site-shell narrative-page narrative-page--now">
    <header class="narrative-page__header">
      <p class="eyebrow">近况 / 此刻</p>
      <h1>{title}</h1>
      <p>{description}</p>
      <time datetime={toIsoDate(updatedAt)}>更新于 {formatDate(updatedAt)}</time
      >
    </header>

    <div class="narrative-page__grid">
      <div class="prose narrative-page__body">
        {PageContent ? <PageContent /> : <p>{site.now.summary}</p>}
      </div>
      <aside class="narrative-page__aside">
        <p class="eyebrow">继续浏览</p>
        <ArrowLink href="/about/" label="关于" />
        <ArrowLink href="/studio/" label="作品" />
      </aside>
    </div>
  </article>
</BaseLayout>
