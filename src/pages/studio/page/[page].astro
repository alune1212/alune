---
import type { CollectionEntry } from "astro:content";

import EntryList from "../../../components/EntryList.astro";
import Pagination from "../../../components/Pagination.astro";
import ListingLayout from "../../../layouts/ListingLayout.astro";
import { getStudioEntries } from "../../../lib/collections";
import { PAGE_SIZE, paginate, type PageSlice } from "../../../lib/pagination";
import { studioViewModel } from "../../../lib/view-models";

export async function getStaticPaths() {
  const entries = await getStudioEntries({ production: import.meta.env.PROD });
  const totalPages = Math.ceil(entries.length / PAGE_SIZE);

  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => {
    const pageNumber = index + 2;
    return {
      params: { page: String(pageNumber) },
      props: { page: paginate(entries, pageNumber) },
    };
  });
}

interface Props {
  page: PageSlice<CollectionEntry<"studio">>;
}

const { page } = Astro.props;
const items = page.items.map(studioViewModel);
---

<ListingLayout
  title={`Studio — Page ${page.currentPage}`}
  eyebrow="STUDIO / ARCHIVE"
  description="More projects, tools, open-source work, and experiments from the Studio archive."
  bodyClass="studio-page"
>
  <EntryList entries={items} label={`Studio page ${page.currentPage}`} />
  <Pagination section="studio" {...page} />
</ListingLayout>
