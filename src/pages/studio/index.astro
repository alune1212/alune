---
import EntryList from "../../components/EntryList.astro";
import Pagination from "../../components/Pagination.astro";
import TopicList from "../../components/TopicList.astro";
import type { TopicItem } from "../../components/types";
import ListingLayout from "../../layouts/ListingLayout.astro";
import { getStudioEntries } from "../../lib/collections";
import { countTopics, topicLabel } from "../../lib/topics";
import { paginate } from "../../lib/pagination";
import { studioPreviewEntries } from "../../lib/preview";
import { studioViewModel } from "../../lib/view-models";

const entries = await getStudioEntries({ production: import.meta.env.PROD });
const page = paginate(entries, 1);
const items = page.items.map(studioViewModel);
const displayItems =
  import.meta.env.DEV && items.length === 0 ? studioPreviewEntries : items;
const topicCounts = countTopics(entries.map((entry) => entry.data));
const topics: TopicItem[] = Object.entries(topicCounts).map(
  ([slug, count]) => ({
    slug,
    label: topicLabel(slug),
    count,
  }),
);
---

<ListingLayout
  title="作品"
  eyebrow="作品 / 创作记录"
  description="这里收录项目、工具、开源作品与实验，无论已经完成，还是仍在生长。"
  bodyClass="studio-page"
>
  {
    topics.length > 0 && (
      <TopicList
        slot="topics"
        topics={topics}
        label="作品主题"
        class="listing-topics"
      />
    )
  }
  <EntryList
    entries={displayItems}
    label="作品列表"
    emptyTitle="还没有发布作品。"
    emptyMessage="准备完成后，项目、工具与实验会出现在这里。"
  />
  <Pagination section="studio" {...page} />
</ListingLayout>
