---
import ArrowLink from "../components/ArrowLink.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="页面未找到"
  description="未找到你请求的页面。"
  canonical={false}
  noindex={true}
  bodyClass="not-found-page"
>
  <section class="site-shell not-found" aria-labelledby="not-found-title">
    <p class="eyebrow">错误 / 404</p>
    <h1 id="not-found-title">这条路径暂时没有内容。</h1>
    <p>页面可能已移动、更名，或从未存在。</p>
    <ArrowLink href="/" label="返回首页" />
  </section>
</BaseLayout>
