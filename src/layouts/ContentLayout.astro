---
import ArrowLink from "../components/ArrowLink.astro";
import TopicList from "../components/TopicList.astro";
import { formatDate, toIsoDate } from "../lib/dates";
import { kindLabel, statusLabel } from "../lib/labels";
import type { StructuredData } from "../lib/structured-data";
import BaseLayout from "./BaseLayout.astro";

export interface Props {
  title: string;
  description: string;
  kind: string;
  status?: string;
  topics?: readonly string[];
  publishedAt?: Date;
  updatedAt?: Date;
  backHref: string;
  backLabel: string;
  canonical?: string;
  image?: string;
  structuredData?: StructuredData | StructuredData[];
}

const {
  title,
  description,
  kind,
  status,
  topics = [],
  publishedAt,
  updatedAt,
  backHref,
  backLabel,
  canonical,
  image,
  structuredData,
} = Astro.props;

const displayKind = kindLabel(kind);
const displayStatus = status ? statusLabel(status) : undefined;
---

<BaseLayout
  title={title}
  description={description}
  canonical={canonical}
  image={image}
  type="article"
  structuredData={structuredData}
  bodyClass="content-page"
>
  <article class="site-shell article-shell">
    <header class="article-header">
      <ArrowLink
        href={backHref}
        label={backLabel}
        class="article-header__back"
      />
      <div class="article-header__meta metadata-row">
        <span>{displayKind}</span>
        {displayStatus && <span>{displayStatus}</span>}
        {
          publishedAt && (
            <time datetime={toIsoDate(publishedAt)}>
              {formatDate(publishedAt)}
            </time>
          )
        }
        {
          updatedAt &&
            (!publishedAt || updatedAt.getTime() !== publishedAt.getTime()) && (
              <time datetime={toIsoDate(updatedAt)}>
                更新于 {formatDate(updatedAt)}
              </time>
            )
        }
      </div>
      <h1>{title}</h1>
      <p class="article-header__summary">{description}</p>
      {topics.length > 0 && <TopicList topics={topics} />}
    </header>

    <div class="article-layout">
      <div class="prose article-body">
        <slot />
      </div>
      <aside class="article-aside">
        <slot name="aside" />
      </aside>
    </div>
  </article>
</BaseLayout>
