---
import SEO from "../components/SEO.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { primaryNavigation, site } from "../config/site";
import { sectionLabels } from "../lib/labels";
import type { StructuredData } from "../lib/structured-data";
import "../styles/global.css";

export interface Props {
  title?: string;
  description?: string;
  canonical?: string | false;
  image?: string;
  type?: "website" | "article";
  noindex?: boolean;
  structuredData?: StructuredData | StructuredData[];
  bodyClass?: string;
}

const {
  title,
  description,
  canonical,
  image,
  type = "website",
  noindex = false,
  structuredData,
  bodyClass,
} = Astro.props;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="theme-color"
      content="#ffffff"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#0c0c0d"
      media="(prefers-color-scheme: dark)"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${site.name} ${sectionLabels.journal}`}
      href={new URL("rss.xml", Astro.site)}
    />
    <SEO
      title={title}
      description={description}
      canonical={canonical === undefined ? Astro.url.href : canonical}
      image={image}
      type={type}
      noindex={noindex || site.placeholder}
      structuredData={structuredData}
    />
    <script is:inline>
      (() => {
        try {
          const saved = localStorage.getItem("alune-theme");
          const theme =
            saved === "light" || saved === "dark"
              ? saved
              : matchMedia("(prefers-color-scheme: dark)").matches
                ? "dark"
                : "light";
          document.documentElement.dataset.theme = theme;
          document.documentElement.style.colorScheme = theme;
        } catch {
          // The CSS media query remains the no-storage fallback.
        }
      })();
    </script>
  </head>
  <body class:list={[bodyClass]}>
    <SiteHeader
      currentPath={Astro.url.pathname}
      wordmark={site.name}
      navItems={primaryNavigation}
    />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter
      navItems={primaryNavigation}
      statement="一个不断生长的个人数字主页。"
    />
  </body>
</html>
