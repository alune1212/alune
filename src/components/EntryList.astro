---
import EmptyState from "./EmptyState.astro";
import EntryPreview from "./EntryPreview.astro";
import type { EntryPreviewData } from "./types";

export interface Props {
  entries: readonly EntryPreviewData[];
  label?: string;
  emptyTitle?: string;
  emptyMessage?: string;
  emptyActionHref?: string;
  emptyActionLabel?: string;
  class?: string;
}

const {
  entries,
  label = "条目",
  emptyTitle = "这里还没有内容",
  emptyMessage = "此内容集合尚未发布任何条目。",
  emptyActionHref,
  emptyActionLabel,
  class: className,
} = Astro.props;
---

{
  entries.length > 0 ? (
    <ul class:list={["entry-list", className]} aria-label={label}>
      {entries.map((entry) => (
        <li>
          <EntryPreview {...entry} />
        </li>
      ))}
    </ul>
  ) : (
    <EmptyState
      class:list={[className]}
      title={emptyTitle}
      message={emptyMessage}
      actionHref={emptyActionHref}
      actionLabel={emptyActionLabel}
    />
  )
}
