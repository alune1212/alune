---
import TopicLink from "./TopicLink.astro";
import type { TopicValue } from "./types";

export interface Props {
  topics: readonly TopicValue[];
  label?: string;
  class?: string;
}

const { topics, label = "主题", class: className } = Astro.props;
---

{
  topics.length > 0 && (
    <nav class:list={["topic-list", className]} aria-label={label}>
      <ul>
        {topics.map((topic) => (
          <li>
            <TopicLink topic={topic} />
          </li>
        ))}
      </ul>
    </nav>
  )
}
