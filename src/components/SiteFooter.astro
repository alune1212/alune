---
interface NavItem {
  label: string;
  href: string;
}

export interface Props {
  year?: number;
  wordmark: string;
  statement: string;
  homeHref?: string;
  navItems: readonly NavItem[];
}

const {
  year = new Date().getFullYear(),
  wordmark,
  statement,
  homeHref = "/",
  navItems,
} = Astro.props;
---

<footer class="site-footer">
  <div class="site-shell site-footer__inner">
    <div class="site-footer__identity">
      <a
        class="site-footer__wordmark"
        href={homeHref}
        aria-label={`${wordmark} 首页`}>{wordmark}</a
      >
      <p>{statement}</p>
    </div>

    <nav class="site-footer__nav" aria-label="页脚导航">
      <ul>
        {
          navItems.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <p class="site-footer__legal"><small>© {year} {wordmark}</small></p>
  </div>
</footer>
