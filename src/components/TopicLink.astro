---
import type { TopicItem, TopicValue } from "./types";
import { topicCountLabel } from "../lib/labels";
import { topicPath } from "../lib/routes";
import { topicLabel } from "../lib/topics";

export interface Props {
  topic: TopicValue;
}

const { topic } = Astro.props;

const item: TopicItem = typeof topic === "string" ? { slug: topic } : topic;
const slug = item.slug.trim();
const displayLabel = item.label ?? topicLabel(slug);
const href = topicPath(slug);
const count = item.count;
---

<a
  class="topic-link"
  href={href}
  aria-label={`主题：${displayLabel}`}
  data-topic={slug}
>
  <span>{displayLabel}</span>
  {typeof count === "number" && (
    <span class="topic-link__count" aria-label={topicCountLabel(count)}>
      {count}
    </span>
  )}
</a>
