---
import ArrowLink from "./ArrowLink.astro";
import TopicLink from "./TopicLink.astro";
import type { EntryPreviewData } from "./types";
import { formatDate } from "../lib/dates";
import { kindLabel, statusLabel } from "../lib/labels";

export interface Props extends EntryPreviewData {
  topicBaseHref?: string;
  class?: string;
}

const {
  id,
  title,
  summary,
  href,
  kind,
  status,
  date,
  dateLabel,
  meta,
  topics = [],
  cover,
  coverAlt = "",
  featured = false,
  actionLabel,
  topicBaseHref = "/journal",
  class: className,
} = Astro.props;

const dateValue =
  date instanceof Date ? date : date ? new Date(date) : undefined;
const formattedDate =
  dateLabel ??
  (dateValue && !Number.isNaN(dateValue.getTime())
    ? formatDate(dateValue)
    : undefined);
const isoDate =
  dateValue && !Number.isNaN(dateValue.getTime())
    ? dateValue.toISOString().slice(0, 10)
    : undefined;
const metadata = [
  kind ? kindLabel(kind) : undefined,
  status ? statusLabel(status) : undefined,
  ...(typeof meta === "string" ? [meta] : (meta ?? [])),
].filter((value): value is string => Boolean(value));
const resolvedActionLabel =
  actionLabel ??
  (kind === "project" || kind === "tool" ? "查看作品" : "阅读文章");
---

<article
  class:list={["entry-preview", { "is-featured": featured }, className]}
  data-entry-id={id}
  data-entry-kind={kind}
>
  {
    cover && (
      <div class="entry-preview__media">
        <img src={cover} alt={coverAlt} loading="lazy" decoding="async" />
      </div>
    )
  }
  <div class="entry-preview__body">
    <div class="entry-preview__meta" aria-label="条目元数据">
      {metadata.map((value) => <span>{value}</span>)}
      {formattedDate && <time datetime={isoDate}>{formattedDate}</time>}
    </div>
    <h3><a href={href}>{title}</a></h3>
    <p class="entry-preview__summary">{summary}</p>
    {
      topics.length > 0 && (
        <ul class="entry-preview__topics" aria-label="主题">
          {topics.map((topic) => (
            <li>
              <TopicLink topic={topic} baseHref={topicBaseHref} />
            </li>
          ))}
        </ul>
      )
    }
    <ArrowLink href={href} label={resolvedActionLabel} />
  </div>
</article>
